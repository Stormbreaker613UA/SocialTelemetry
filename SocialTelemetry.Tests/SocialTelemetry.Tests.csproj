<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SocialTelemetry.Api\SocialTelemetry.Api.csproj" />
    <ProjectReference Include="..\SocialTelemetry.Domain\SocialTelemetry.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\SocialTelemetry.Domain\SocialTelemetry.Domain.csproj"
          Link="Architecture\SocialTelemetry.Domain.csproj" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
